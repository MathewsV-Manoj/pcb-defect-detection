# Raspberry Pi station service
PCB_STATION_HOST=0.0.0.0
PCB_STATION_PORT=8080

# IR sensor and external LED driver (BCM GPIO numbering)
PCB_IR_GPIO=
PCB_IR_ACTIVE_LOW=true
PCB_IR_PULL_UP=off
PCB_LED_DRIVER_GPIO=
PCB_LED_DRIVER_ACTIVE_LOW=false

# Camera and vision model
PCB_CAMERA_MODE=usb
PCB_CAMERA_INDEX=0
PCB_MODEL_PATH=models/best.onnx
PCB_CONFIDENCE_THRESHOLD=0.25
PCB_NMS_IOU_THRESHOLD=0.45

# Llama 3.2 1B Instruct SpinQuant INT4/EO8 on-device advisory (ExecuTorch)
# Download model/tokenizer: python llm_advisory/download_model.py
# Build on Pi 5, or cross-build on x86_64 with EXECUTORCH_SYSROOT set to the Pi root filesystem.
PCB_LLAMA_MODEL_PATH=models/llama/Llama-3.2-1B-Instruct-SpinQuant_INT4_EO8.pte
PCB_LLAMA_TOKENIZER_PATH=models/llama/tokenizer.model
PCB_LLAMA_RUNNER_PATH=models/llama/runtime/llama_main
PCB_LLAMA_BACKEND=cli
PCB_LLAMA_SEQ_LEN=1024
PCB_LLAMA_TIMEOUT_SECONDS=180
PCB_LLAMA_REQUIRED=true

# Capture timing, local records and optional Firebase synchronization
PCB_ILLUMINATION_SETTLE_SECONDS=0.35
PCB_OUTPUT_DIR=inspection_runs
PCB_FIREBASE_PUBLISH=false
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_AUTH_TOKEN=

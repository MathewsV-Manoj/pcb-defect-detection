# Raspberry Pi station service
PCB_STATION_HOST=0.0.0.0
PCB_STATION_PORT=8080

# IR sensor and external LED driver (BCM GPIO numbering)
PCB_IR_GPIO=
PCB_IR_ACTIVE_LOW=true
PCB_IR_PULL_UP=off
PCB_LED_DRIVER_GPIO=
PCB_LED_DRIVER_ACTIVE_LOW=false

# Camera and vision model
PCB_CAMERA_MODE=usb
PCB_CAMERA_INDEX=0
PCB_MODEL_PATH=models/best.onnx
PCB_CONFIDENCE_THRESHOLD=0.25
PCB_NMS_IOU_THRESHOLD=0.45

# Advisory model: required for the complete inspection workflow
PCB_LLAMA_MODEL_PATH=
PCB_LLAMA_TOKENIZER_PATH=
PCB_LLAMA_REQUIRED=true

# Capture timing, local records and optional Firebase synchronization
PCB_ILLUMINATION_SETTLE_SECONDS=0.35
PCB_OUTPUT_DIR=inspection_runs
PCB_FIREBASE_PUBLISH=false
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_AUTH_TOKEN=
